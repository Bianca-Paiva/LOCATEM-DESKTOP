<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Locacoes.Gerenciar.LocacaoLocadorCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:locacoes="clr-namespace:LOCATEM_DESKTOP.Components.Locacoes"
    x:Name="Root">

    <Border
        x:Name="CardBorder"
        BackgroundColor="{StaticResource AuthCardBackgroundColor}"
        Stroke="#EEEEEE"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 16">

        <VerticalStackLayout Spacing="0">
            <Grid
                x:Name="CabecalhoGrid"
                Padding="20,18"
                ColumnDefinitions="90,*,Auto"
                ColumnSpacing="16">

                <Border
                    x:Name="MiniaturaContainer"
                    Grid.Column="0"
                    WidthRequest="90"
                    HeightRequest="90"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    VerticalOptions="Center">
                    <Image
                        Source="{Binding Locacao.Imagem, Source={x:Reference Root}}"
                        Aspect="AspectFit" />
                </Border>

                <VerticalStackLayout
                    x:Name="ConteudoPrincipal"
                    Grid.Column="1"
                    Spacing="7"
                    VerticalOptions="Center">

                    <Label
                        Text="{Binding Locacao.Produto, Source={x:Reference Root}}"
                        FontFamily="InterBold"
                        FontSize="16"
                        MaxLines="2"
                        LineBreakMode="TailTruncation"
                        TextColor="{StaticResource TextPrimaryColor}" />

                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center">
                        <HorizontalStackLayout Spacing="5" Margin="0,0,20,0">
                            <mi:MauiIcon Icon="{mi:Material Person}" IconSize="14" IconColor="{StaticResource TextMutedColor}" />
                            <Label
                                Text="{Binding Locacao.Locatario, Source={x:Reference Root}}"
                                FontFamily="InterRegular"
                                FontSize="13"
                                TextColor="{StaticResource TextMutedColor}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="5">
                            <mi:MauiIcon Icon="{mi:Material CalendarToday}" IconSize="14" IconColor="{StaticResource TextMutedColor}" />
                            <Label
                                Text="{Binding Locacao.Periodo, Source={x:Reference Root}}"
                                FontFamily="InterRegular"
                                FontSize="13"
                                TextColor="{StaticResource TextMutedColor}" />
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <Label
                        x:Name="MensagemStatusLabel"
                        Text="{Binding Locacao.MensagemStatus, Source={x:Reference Root}}"
                        FontFamily="InterRegular"
                        FontSize="12"
                        TextColor="{StaticResource TextMutedColor}" />
                </VerticalStackLayout>

                <HorizontalStackLayout
                    x:Name="Aside"
                    Grid.Column="2"
                    Spacing="10"
                    VerticalOptions="Center"
                    HorizontalOptions="End">

                    <locacoes:EtiquetaStatus Status="{Binding Locacao.Status, Source={x:Reference Root}}" />

                    <Label
                        Text="{Binding Locacao.Valor, Source={x:Reference Root}}"
                        FontFamily="InterExtraBold"
                        FontSize="14"
                        LineBreakMode="NoWrap"
                        VerticalOptions="Center"
                        TextColor="{StaticResource TextPrimaryColor}" />

                    <Label
                        x:Name="ExpandirGlyph"
                        Text="⌄"
                        FontFamily="InterBold"
                        FontSize="18"
                        WidthRequest="22"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        TextColor="#9AA0A6" />
                </HorizontalStackLayout>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCardTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <VerticalStackLayout
                x:Name="PainelExpandido"
                IsVisible="False"
                Spacing="18"
                Padding="20,4,20,20">

                <BoxView HeightRequest="1" BackgroundColor="#F2F2F2" Margin="-20,0,-20,0" />

                <Border
                    Padding="14"
                    BackgroundColor="#FAFAFA"
                    Stroke="#EEEEEE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border
                            WidthRequest="34"
                            HeightRequest="34"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 17"
                            BackgroundColor="#FFF8D6"
                            VerticalOptions="Start">
                            <mi:MauiIcon
                                x:Name="AcaoIcone"
                                IconSize="17"
                                IconColor="#6F5A18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label
                                Text="O QUE VOCÊ PRECISA FAZER AGORA"
                                FontFamily="InterBold"
                                FontSize="10"
                                CharacterSpacing="0.3"
                                TextColor="#7A7F87" />
                            <Label
                                x:Name="AcaoTituloLabel"
                                FontFamily="InterExtraBold"
                                FontSize="14.5"
                                TextColor="{StaticResource TextPrimaryColor}" />
                            <Label
                                x:Name="AcaoDescricaoLabel"
                                FontFamily="InterRegular"
                                FontSize="12"
                                TextColor="{StaticResource TextMutedColor}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid
                    x:Name="InfoGrade"
                    Padding="14"
                    RowSpacing="14"
                    ColumnSpacing="18"
                    BackgroundColor="#F7F8F9">

                    <VerticalStackLayout x:Name="InfoEntrega" Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <mi:MauiIcon Icon="{mi:Material Schedule}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Horário da entrega" FontFamily="InterBold" FontSize="12" TextColor="{StaticResource TextPrimaryColor}" />
                        </HorizontalStackLayout>
                        <Label x:Name="HorarioEntregaLabel" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimaryColor}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="InfoDevolucao" Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <mi:MauiIcon Icon="{mi:Material Assignment}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Receber devolução" FontFamily="InterBold" FontSize="12" TextColor="{StaticResource TextPrimaryColor}" />
                        </HorizontalStackLayout>
                        <Label x:Name="JanelaDevolucaoLabel" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimaryColor}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="InfoQuantidade" Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <mi:MauiIcon Icon="{mi:Material Inventory2}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Quantidade" FontFamily="InterBold" FontSize="12" TextColor="{StaticResource TextPrimaryColor}" />
                        </HorizontalStackLayout>
                        <Label x:Name="QuantidadeLabel" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimaryColor}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="InfoProximaEtapa" Spacing="4">
                        <HorizontalStackLayout Spacing="6">
                            <mi:MauiIcon Icon="{mi:Material ChevronRight}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Próxima etapa" FontFamily="InterBold" FontSize="12" TextColor="{StaticResource TextPrimaryColor}" />
                        </HorizontalStackLayout>
                        <Label x:Name="ProximaEtapaTituloLabel" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimaryColor}" />
                        <Label x:Name="ProximaEtapaDescricaoLabel" FontFamily="InterRegular" FontSize="11.5" TextColor="{StaticResource TextMutedColor}" />
                    </VerticalStackLayout>
                </Grid>

                <Border
                    Padding="14"
                    BackgroundColor="#F7F8F9"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <mi:MauiIcon Icon="{mi:Material Assignment}" IconSize="16" IconColor="{StaticResource TextMutedColor}" />
                                <Label Text="Ver mais da locação" FontFamily="InterBold" FontSize="13" TextColor="{StaticResource TextPrimaryColor}" />
                            </HorizontalStackLayout>
                            <Label
                                Text="Confira todas as informações, mensagens, comprovantes e observações."
                                FontFamily="InterRegular"
                                FontSize="12"
                                TextColor="{StaticResource TextMutedColor}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="18,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{StaticResource AuthPrimaryColor}"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Ver detalhes" FontFamily="InterExtraBold" FontSize="13" TextColor="{StaticResource TextPrimaryColor}" />
                                <mi:MauiIcon Icon="{mi:Material ChevronRight}" IconSize="16" IconColor="{StaticResource TextPrimaryColor}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
