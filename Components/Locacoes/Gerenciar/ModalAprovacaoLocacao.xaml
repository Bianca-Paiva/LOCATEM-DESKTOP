<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Locacoes.Gerenciar.ModalAprovacaoLocacao"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:Name="Root"
    IsVisible="{Binding IsOpen, Source={x:Reference Root}}"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <Grid
        Padding="20"
        BackgroundColor="#73000000"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Border
            MaximumWidthRequest="480"
            Padding="22"
            BackgroundColor="{StaticResource AuthCardBackgroundColor}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="14">
                    <Border
                        WidthRequest="68"
                        HeightRequest="68"
                        Stroke="#EEEEEE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#F7F8F9">
                        <Image
                            Source="{Binding Locacao.Imagem, Source={x:Reference Root}}"
                            Aspect="AspectFit" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Start">
                        <Label
                            Text="Solicitação de Locação"
                            FontFamily="InterExtraBold"
                            FontSize="17"
                            TextColor="{StaticResource TextPrimaryColor}" />
                        <Label
                            Text="Revise os detalhes da solicitação e aprove ou recuse a locação deste equipamento."
                            FontFamily="InterRegular"
                            FontSize="12.5"
                            TextColor="{StaticResource TextMutedColor}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="2"
                        WidthRequest="28"
                        HeightRequest="28"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#F3F4F6"
                        VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <mi:MauiIcon
                            Icon="{mi:Material Close}"
                            IconSize="16"
                            IconColor="{StaticResource TextMutedColor}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="0">
                    <Grid Padding="0,11" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="7">
                            <mi:MauiIcon Icon="{mi:Material Build}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Ferramenta" FontFamily="InterRegular" FontSize="13" TextColor="{StaticResource TextMutedColor}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Locacao.Produto, Source={x:Reference Root}}" FontFamily="InterBold" FontSize="13.5" HorizontalTextAlignment="End" TextColor="{StaticResource TextPrimaryColor}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6" />

                    <Grid Padding="0,11" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="7">
                            <mi:MauiIcon Icon="{mi:Material Person}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Locatário" FontFamily="InterRegular" FontSize="13" TextColor="{StaticResource TextMutedColor}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Locacao.Locatario, Source={x:Reference Root}}" FontFamily="InterBold" FontSize="13.5" HorizontalTextAlignment="End" TextColor="{StaticResource TextPrimaryColor}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6" />

                    <Grid Padding="0,11" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="7">
                            <mi:MauiIcon Icon="{mi:Material CalendarToday}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Período" FontFamily="InterRegular" FontSize="13" TextColor="{StaticResource TextMutedColor}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Locacao.Periodo, Source={x:Reference Root}}" FontFamily="InterBold" FontSize="13.5" HorizontalTextAlignment="End" TextColor="{StaticResource TextPrimaryColor}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6" />

                    <Grid Padding="0,11" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="7">
                            <mi:MauiIcon Icon="{mi:Material Payments}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Valor total" FontFamily="InterRegular" FontSize="13" TextColor="{StaticResource TextMutedColor}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Locacao.Valor, Source={x:Reference Root}}" FontFamily="InterExtraBold" FontSize="15" HorizontalTextAlignment="End" TextColor="#15803D" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6" />

                    <Grid Padding="0,11,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <HorizontalStackLayout Spacing="7" VerticalOptions="Start">
                            <mi:MauiIcon Icon="{mi:Material LocationOn}" IconSize="15" IconColor="{StaticResource TextMutedColor}" />
                            <Label Text="Endereço de entrega" FontFamily="InterRegular" FontSize="13" TextColor="{StaticResource TextMutedColor}" />
                        </HorizontalStackLayout>
                        <Label
                            Grid.Column="1"
                            x:Name="EnderecoLabel"
                            FontFamily="InterBold"
                            FontSize="13.5"
                            HorizontalTextAlignment="End"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource TextPrimaryColor}" />
                    </Grid>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border
                        Grid.Column="0"
                        HeightRequest="55"
                        Stroke="#F3B8B8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#FDECEC">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RejectCommand, Source={x:Reference Root}}" CommandParameter="{Binding Locacao, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="7" HorizontalOptions="Center" VerticalOptions="Center">
                            <mi:MauiIcon Icon="{mi:Material Close}" IconSize="16" IconColor="#C0392B" />
                            <Label Text="Recusar" FontFamily="InterBold" FontSize="15" TextColor="#C0392B" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        HeightRequest="55"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource AuthPrimaryColor}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ApproveCommand, Source={x:Reference Root}}" CommandParameter="{Binding Locacao, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="7" HorizontalOptions="Center" VerticalOptions="Center">
                            <mi:MauiIcon Icon="{mi:Material Check}" IconSize="17" IconColor="{StaticResource TextPrimaryColor}" />
                            <Label Text="Aprovar solicitação" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource TextPrimaryColor}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
