<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Shared.PasswordEntry"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:behaviors="clr-namespace:LOCATEM_DESKTOP.Behaviors"
    x:Name="Root">

    <VerticalStackLayout Spacing="6">

        <HorizontalStackLayout Spacing="2">
            <Label Text="{Binding Label, Source={x:Reference Root}}" FontSize="15" FontFamily="InterSemiBold" TextColor="{StaticResource TextPrimaryColor}" />
            <Label Text=" *" FontSize="16" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding IsRequiredField, Source={x:Reference Root}}" />
        </HorizontalStackLayout>

        <Border x:Name="InputBorder"
                Stroke="{StaticResource InputBorderColor}"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource AuthInputBackgroundColor}"
                HeightRequest="48">
            <Border.Behaviors>
                <behaviors:ShakeBehavior IsShaking="{Binding IsShaking, Source={x:Reference Root}}" />
            </Border.Behaviors>
            <Grid ColumnDefinitions="*,Auto" Margin="10,0">
                <Entry 
                    Grid.Column="0"
                    Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                    Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                    IsPassword="{Binding IsPassword, Source={x:Reference Root}}"
                    FontFamily="InterRegular"
                    TextColor="{StaticResource TextPrimaryColor}"
                    PlaceholderColor="{StaticResource TextSecondaryColor}"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center" 
                />

                <Grid Grid.Column="1" VerticalOptions="Center" Padding="6">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleVisibilityClicked" />
                    </Grid.GestureRecognizers>

                    <!-- Ícones "mostrar senha" / "ocultar senha" (AathifMahir.Maui.MauiIcons.Material) -->
                    <mi:MauiIcon IsVisible="{Binding IsPasswordVisible, Source={x:Reference Root}}"
                                 Icon="{mi:Material Visibility}"
                                 IconSize="20"
                                 IconColor="{StaticResource TextBodyColor}" />
                    <mi:MauiIcon IsVisible="{Binding IsPasswordVisible, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}"
                                 Icon="{mi:Material VisibilityOff}"
                                 IconSize="20"
                                 IconColor="{StaticResource TextBodyColor}" />
                </Grid>
            </Grid>
        </Border>

        <Label Text="{Binding ErrorText, Source={x:Reference Root}}"
               TextColor="{StaticResource ErrorColor}"
               FontSize="13"
               FontAttributes="Bold"
               IsVisible="{Binding HasErrorText, Source={x:Reference Root}}" />

    </VerticalStackLayout>
</ContentView>
