<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Shared.FormEntry"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:LOCATEM_DESKTOP.Behaviors"
    x:Name="Root">

    <VerticalStackLayout Spacing="6">

        <HorizontalStackLayout Spacing="2">
            <Label 
                Text="{Binding Label, Source={x:Reference Root}}" 
                FontSize="15" 
                FontFamily="InterSemiBold" 
                TextColor="{StaticResource TextPrimaryColor}" 
            />
            <Label 
                Text="*" 
                FontSize="16" 
                TextColor="{StaticResource ErrorColor}" 
                IsVisible="{Binding IsRequiredField, Source={x:Reference Root}}" 
            />
        </HorizontalStackLayout>

        <Border 
            x:Name="InputBorder"
            Stroke="{StaticResource InputBorderColor}"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 10"
            BackgroundColor="{StaticResource AuthInputBackgroundColor}"
            HeightRequest="48"
        >
            
            <Border.Behaviors>
                <behaviors:ShakeBehavior IsShaking="{Binding IsShaking, Source={x:Reference Root}}" />
            </Border.Behaviors>

            <Entry
                x:Name="InnerEntry"
                Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                Keyboard="{Binding EntryKeyboard, Source={x:Reference Root}}"

                FontSize="14"
                TextColor="{StaticResource TextPrimaryColor}"
                PlaceholderColor="{StaticResource TextSecondaryColor}"

                BackgroundColor="Transparent"
                VerticalOptions="Center"
                Margin="10,0"

                Unfocused="OnEntryUnfocused"
            />      
        </Border>

        <Label 
            Text="{Binding ErrorText, Source={x:Reference Root}}"
            TextColor="{StaticResource ErrorColor}"
            FontSize="13"
            IsVisible="{Binding HasErrorText, Source={x:Reference Root}}" 
        />

    </VerticalStackLayout>
</ContentView>
