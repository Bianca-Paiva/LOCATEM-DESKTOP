<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Shared.PageHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,24,0,16">
        <Label Text="{Binding Title, Source={x:Reference Root}}"
               FontSize="24" FontAttributes="Bold"
               TextColor="{StaticResource TextPrimaryColor}"
               HorizontalTextAlignment="Center" />
        <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
               FontSize="14"
               TextColor="#666666"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
