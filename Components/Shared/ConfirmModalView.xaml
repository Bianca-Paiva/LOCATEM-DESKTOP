<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Shared.ConfirmModalView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    IsVisible="{Binding IsOpen, Source={x:Reference Root}}"
    InputTransparent="False"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <Grid
        Padding="20"
        BackgroundColor="#73000000"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Border
            MaximumWidthRequest="430"
            Padding="24"
            BackgroundColor="{StaticResource AuthCardBackgroundColor}"
            Stroke="{StaticResource InputBorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="7">
                    <Label
                        Text="{Binding Title, Source={x:Reference Root}}"
                        FontSize="20"
                        FontFamily="InterExtraBold"
                        TextColor="{StaticResource TextPrimaryColor}" />

                    <Label
                        Text="{Binding Message, Source={x:Reference Root}}"
                        FontSize="14"
                        LineBreakMode="WordWrap"
                        TextColor="{StaticResource TextMutedColor}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button
                        Grid.Column="0"
                        Text="{Binding CancelText, Source={x:Reference Root}}"
                        Style="{StaticResource BtnNeutroStyle}"
                        Command="{Binding CancelCommand, Source={x:Reference Root}}" />

                    <Button
                        Grid.Column="1"
                        Text="{Binding ConfirmText, Source={x:Reference Root}}"
                        Style="{StaticResource BtnNegativoStyle}"
                        Command="{Binding ConfirmCommand, Source={x:Reference Root}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
