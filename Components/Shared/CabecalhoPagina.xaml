<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Shared.CabecalhoPagina"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="4">
        <Label Text="{Binding Titulo, Source={x:Reference Root}}"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimaryColor}" />
        <Label Text="{Binding Subtitulo, Source={x:Reference Root}}"
               FontSize="14"
               TextColor="{StaticResource TextMutedColor}"
               IsVisible="{Binding HasSubtitulo, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
