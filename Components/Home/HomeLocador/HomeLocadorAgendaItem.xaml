<?xml version="1.0" encoding="UTF-8" ?>

<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Home.HomeLocador.HomeLocadorAgendaItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:LOCATEM_DESKTOP.Models.Home"
    x:DataType="models:AgendaSemanaLocadorItem">

    <VerticalStackLayout Spacing="0">

        <Grid
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="12"
            Padding="0,12">

            <!-- DATA -->
            <VerticalStackLayout
                Grid.Column="0"
                WidthRequest="38"
                Spacing="0"
                VerticalOptions="Start">

                <Label
                    x:Name="Dia"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource TextPrimaryColor}" />

                <Label
                    x:Name="Mes"
                    FontSize="11"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource TextMutedColor}" />

            </VerticalStackLayout>

            <!-- IMAGEM -->
            <Border
                Grid.Column="1"
                WidthRequest="40"
                HeightRequest="40"
                StrokeThickness="1"
                Stroke="{StaticResource CardBorderColor}"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="White"
                VerticalOptions="Start">

                <Image
                    Source="{Binding Imagem}"
                    Aspect="AspectFit" />

            </Border>

            <!-- CONTEÚDO -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="7">

                <!-- Produto -->
                <VerticalStackLayout Spacing="2">

                    <Label
                        Text="{Binding Ferramenta}"
                        FontSize="14"
                        FontAttributes="Bold"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        TextColor="{StaticResource TextPrimaryColor}" />

                    <Label
                        Text="{Binding Locatario}"
                        FontSize="12"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        TextColor="{StaticResource TextMutedColor}" />

                </VerticalStackLayout>

                <!--
                    Horário e movimento podem quebrar de linha
                    quando não houver espaço.
                -->
                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Center">

                    <!-- HORÁRIO -->
                    <HorizontalStackLayout
                        Spacing="4"
                        Margin="0,0,12,5"
                        VerticalOptions="Center">

                        <mi:MauiIcon
                            Icon="{mi:Material Schedule}"
                            IconSize="13"
                            IconColor="{StaticResource TextMutedColor}"
                            VerticalOptions="Center" />

                        <Label
                            Text="{Binding Hora}"
                            FontSize="12"
                            LineBreakMode="NoWrap"
                            TextColor="{StaticResource TextMutedColor}"
                            VerticalOptions="Center" />

                    </HorizontalStackLayout>

                    <!-- MOVIMENTO LOGÍSTICO -->
                    <Border
                        x:Name="Movimento"
                        FlexLayout.Shrink="1"
                        Padding="10,6"
                        Margin="0,0,0,5"
                        MaximumWidthRequest="280"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="6">

                            <mi:MauiIcon
                                x:Name="MovimentoIcone"
                                Grid.Column="0"
                                IconSize="13"
                                VerticalOptions="Center" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    x:Name="MovimentoLabel"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    x:Name="MovimentoComplemento"
                                    FontSize="10"
                                    Opacity="0.85"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </FlexLayout>

            </VerticalStackLayout>

        </Grid>

        <BoxView
            HeightRequest="1"
            Color="{StaticResource CardBorderColor}" />

    </VerticalStackLayout>

</ContentView>