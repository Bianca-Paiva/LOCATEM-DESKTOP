<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Home.HomeLocador.HomeLocadorAgendaItem"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:models="clr-namespace:LOCATEM_DESKTOP.Models.Home"
    x:DataType="models:AgendaSemanaLocadorItem">

    <VerticalStackLayout Spacing="0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12" Padding="0,12">

            <VerticalStackLayout Grid.Column="0" WidthRequest="38" Spacing="0" VerticalOptions="Center">
                <Label x:Name="Dia" FontSize="16" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="{StaticResource TextPrimaryColor}" />
                <Label x:Name="Mes" FontSize="11" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" TextColor="{StaticResource TextMutedColor}" />
            </VerticalStackLayout>

            <Border Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="1"
                    Stroke="{StaticResource CardBorderColor}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="White"
                    VerticalOptions="Center">
                <Image Source="{Binding Imagem}" Aspect="AspectFit" />
            </Border>

            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding Ferramenta}" FontSize="14" FontAttributes="Bold"
                       LineBreakMode="TailTruncation" MaxLines="1"
                       TextColor="{StaticResource TextPrimaryColor}" />
                <Label Text="{Binding Locatario}" FontSize="12"
                       LineBreakMode="TailTruncation" MaxLines="1"
                       TextColor="{StaticResource TextMutedColor}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
                <mi:MauiIcon Icon="{mi:Material Schedule}" IconSize="13" IconColor="{StaticResource TextMutedColor}" VerticalOptions="Center" />
                <Label Text="{Binding Hora}" FontSize="12" TextColor="{StaticResource TextMutedColor}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border x:Name="Movimento"
                    Grid.Column="4"
                    Padding="10,6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 999"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <mi:MauiIcon x:Name="MovimentoIcone" IconSize="13" VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="0">
                        <Label x:Name="MovimentoLabel" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="MovimentoComplemento" FontSize="10" Opacity="0.85" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource CardBorderColor}" />
    </VerticalStackLayout>
</ContentView>
