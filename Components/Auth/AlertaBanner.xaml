<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Auth.AlertaBanner"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border BackgroundColor="{StaticResource ErrorBackgroundColor}"
            Stroke="{StaticResource ErrorBorderColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Padding="16"
            Margin="0,0,0,16">

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

            <Border Grid.Column="0"
                    WidthRequest="40" HeightRequest="40"
                    StrokeShape="RoundRectangle 20"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource ErrorBorderColor}"
                    VerticalOptions="Start">
                <Label Text="!" TextColor="{StaticResource ErrorColor}" FontAttributes="Bold" FontSize="20"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="{Binding Titulo, Source={x:Reference Root}}" FontSize="16" TextColor="{StaticResource ErrorTitleColor}" FontAttributes="Bold" />
                <Label Text="{Binding Mensagem, Source={x:Reference Root}}" FontSize="14" TextColor="{StaticResource ErrorBodyColor}" IsVisible="{Binding TemMensagem, Source={x:Reference Root}}" />
            </VerticalStackLayout>

            <Label Grid.Column="2" Text="&#10005;" TextColor="{StaticResource ErrorColor}" FontSize="20" VerticalOptions="Start">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Label.GestureRecognizers>
            </Label>

        </Grid>
    </Border>
</ContentView>
