<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Auth.PasswordStrengthMeter"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="8" IsVisible="{Binding Visivel, Source={x:Reference Root}}">

        <HorizontalStackLayout Spacing="6" HorizontalOptions="Fill">
            <BoxView x:Name="Barra1" HeightRequest="6" WidthRequest="90" CornerRadius="4" Color="{StaticResource PasswordBarIdleColor}" HorizontalOptions="FillAndExpand" />
            <BoxView x:Name="Barra2" HeightRequest="6" WidthRequest="90" CornerRadius="4" Color="{StaticResource PasswordBarIdleColor}" HorizontalOptions="FillAndExpand" />
            <BoxView x:Name="Barra3" HeightRequest="6" WidthRequest="90" CornerRadius="4" Color="{StaticResource PasswordBarIdleColor}" HorizontalOptions="FillAndExpand" />
        </HorizontalStackLayout>

        <Label FontSize="13" TextColor="#64748B">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Segurança: " />
                    <Span Text="{Binding TextoForca, Source={x:Reference Root}}" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

    </VerticalStackLayout>
</ContentView>
