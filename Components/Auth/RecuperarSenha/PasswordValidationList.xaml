<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Auth.RecuperarSenha.PasswordValidationList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:validation="clr-namespace:LOCATEM_DESKTOP.Validation.Auth"
    x:Name="Root">

    <Border StrokeShape="RoundRectangle 24" Stroke="#D0D7DE" StrokeThickness="1" BackgroundColor="White" Padding="24">
        <VerticalStackLayout Spacing="15">

            <Label Text="{Binding Titulo, Source={x:Reference Root}}" FontSize="16" FontAttributes="Bold" TextColor="#1F1F1F" />

            <CollectionView ItemsSource="{Binding Itens, Source={x:Reference Root}}" VerticalOptions="Start">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="validation:PasswordValidationItem">
                        <HorizontalStackLayout Spacing="16">
                            <mi:MauiIcon Icon="{mi:Material Check}" IconSize="20" IconColor="{StaticResource SuccessColor}" IsVisible="{Binding Valid}" />
                            <mi:MauiIcon Icon="{mi:Material Close}" IconSize="20" IconColor="{StaticResource ErrorColor}" IsVisible="{Binding Valid, Converter={StaticResource InvertedBoolConverter}}" />
                            <Label Text="{Binding Label}" FontSize="14" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Valid}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Valid}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Border>
</ContentView>
