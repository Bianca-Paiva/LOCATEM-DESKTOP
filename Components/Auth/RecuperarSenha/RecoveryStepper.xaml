<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Auth.RecuperarSenha.RecoveryStepper"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:Name="Root">

    <HorizontalStackLayout HorizontalOptions="Center" Spacing="0" Margin="0,24">

        <!-- Etapa 1: E-mail -->
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Border x:Name="Circulo1" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 6" Stroke="{StaticResource StepBorderColor}">
                <Label x:Name="Numero1" Text="1" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryMutedColor}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label x:Name="Label1" Text="E-mail" FontSize="14" TextColor="{StaticResource TextSecondaryMutedColor}" VerticalOptions="Center" />
            <mi:MauiIcon x:Name="Check1" Icon="{mi:Material Check}" IconSize="16" IconColor="{StaticResource StepCheckColor}" IsVisible="False" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <BoxView WidthRequest="200" HeightRequest="1" Color="{StaticResource StepBorderColor}" Margin="16,0" VerticalOptions="Center" />

        <!-- Etapa 2: Validação -->
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Border x:Name="Circulo2" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 6" Stroke="{StaticResource StepBorderColor}">
                <Label x:Name="Numero2" Text="2" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryMutedColor}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label x:Name="Label2" Text="Validação" FontSize="14" TextColor="{StaticResource TextSecondaryMutedColor}" VerticalOptions="Center" />
            <mi:MauiIcon x:Name="Check2" Icon="{mi:Material Check}" IconSize="16" IconColor="{StaticResource StepCheckColor}" IsVisible="False" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <BoxView WidthRequest="200" HeightRequest="1" Color="{StaticResource StepBorderColor}" Margin="16,0" VerticalOptions="Center" />

        <!-- Etapa 3: Nova Senha -->
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Border x:Name="Circulo3" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 6" Stroke="{StaticResource StepBorderColor}">
                <Label x:Name="Numero3" Text="3" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextSecondaryMutedColor}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label x:Name="Label3" Text="Nova Senha" FontSize="14" TextColor="{StaticResource TextSecondaryMutedColor}" VerticalOptions="Center" />
            <mi:MauiIcon x:Name="Check3" Icon="{mi:Material Check}" IconSize="16" IconColor="{StaticResource StepCheckColor}" IsVisible="False" VerticalOptions="Center" />
        </HorizontalStackLayout>

    </HorizontalStackLayout>
</ContentView>
