<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Layout.AuthHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid HeightRequest="100" Padding="32,24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFCC00" Offset="0.0" />
                <GradientStop Color="#FFE066" Offset="0.3" />
                <GradientStop Color="#FFF1B3" Offset="0.65" />
                <GradientStop Color="#F9FAFB" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Start">

            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLogoTapped" />
            </HorizontalStackLayout.GestureRecognizers>

            <Image
                Source="logo_locatem.png"
                HeightRequest="32"
                Aspect="AspectFit" 
            />

            <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                <Label
                    Text="LOCATEM"
                    FontSize="22"
                    FontFamily="InterExtraBold"
                    TextColor="{StaticResource TextPrimaryColor}" 
                />

                <Label
                    Text="Portal do Locador"
                    FontSize="12"
                    FontFamily="InterMedium"
                    TextColor="{StaticResource TextPrimaryColor}" 
                />
            </VerticalStackLayout>

        </HorizontalStackLayout>
    </Grid>
</ContentView>