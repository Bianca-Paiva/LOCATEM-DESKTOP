<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Layout.AuthHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid HeightRequest="100" Padding="32,24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource AuthPrimaryColor}" Offset="0.0" />
                <GradientStop Color="{StaticResource AuthPrimaryLightColor}" Offset="0.5" />
                <GradientStop Color="{StaticResource AuthPrimarySoftColor}" Offset="0.75" />
                <GradientStop Color="Transparent" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <HorizontalStackLayout Spacing="7" VerticalOptions="Center" HorizontalOptions="Start">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLogoTapped" />
            </HorizontalStackLayout.GestureRecognizers>

            <Image Source="logolocatem.png" HeightRequest="32" Aspect="AspectFit" />
            <Label Text="LOCATEM" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
