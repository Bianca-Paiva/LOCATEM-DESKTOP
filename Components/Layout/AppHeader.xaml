<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LOCATEM_DESKTOP.Components.Layout.AppHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout BackgroundColor="{StaticResource AuthCardBackgroundColor}" Spacing="0">

        <Grid ColumnDefinitions="Auto,*,Auto" Padding="24,14">

            <HorizontalStackLayout Grid.Column="0" Spacing="7" VerticalOptions="Center">
                <Image Source="logo_locatem.png" HeightRequest="30" Aspect="AspectFit" />
                <Label Text="LOCATEM" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Avatar do usuário autenticado (iniciais do nome, como no Avatar do React) -->
            <Border Grid.Column="2"
                    WidthRequest="38"
                    HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    BackgroundColor="{StaticResource AuthPrimaryColor}"
                    VerticalOptions="Center">
                <Label x:Name="AvatarIniciais"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimaryColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="Navegacao" Spacing="4" Padding="20,0,20,10" />
        </ScrollView>

        <BoxView HeightRequest="1" Color="{StaticResource CardBorderColor}" />
    </VerticalStackLayout>
</ContentView>
