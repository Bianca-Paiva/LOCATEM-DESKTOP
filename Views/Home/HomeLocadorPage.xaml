<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="LOCATEM_DESKTOP.Views.Home.HomeLocadorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:layout="clr-namespace:LOCATEM_DESKTOP.Components.Layout"
    xmlns:shared="clr-namespace:LOCATEM_DESKTOP.Components.Shared"
    xmlns:ferramentas="clr-namespace:LOCATEM_DESKTOP.Components.Ferramentas"
    xmlns:home="clr-namespace:LOCATEM_DESKTOP.Components.Home.HomeLocador"
    xmlns:modelsFerramentas="clr-namespace:LOCATEM_DESKTOP.Models.Ferramentas"
    xmlns:modelsLocacoes="clr-namespace:LOCATEM_DESKTOP.Models.Locacoes"
    xmlns:modelsHome="clr-namespace:LOCATEM_DESKTOP.Models.Home"
    xmlns:avaliacoes="clr-namespace:LOCATEM_DESKTOP.Components.Avaliacoes"
    xmlns:vm="clr-namespace:LOCATEM_DESKTOP.ViewModels.Home"
    x:Name="Pagina"
    x:DataType="vm:HomeLocadorViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AuthBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <layout:AppHeader
                RotaAtual="homeLocador"
                NomeUsuario="{Binding NomeUsuario}"
                NavegarCommand="{Binding NavegarCommand}" />

            <VerticalStackLayout
                Padding="24,20,24,48"
                Spacing="24"
                MaximumWidthRequest="2000">

                <shared:CabecalhoPagina
                    Titulo="{Binding Saudacao}"
                    Subtitulo="{Binding Subtitulo}" />

                <!-- ── Cards de resumo ───────────────────────────────────── -->
                <FlexLayout
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Stretch">

                    <!-- Ferramentas ativas -->
                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="220"
                        Margin="0,0,16,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">

                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource InfoBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Build}"
                                    IconSize="22"
                                    IconColor="{StaticResource InfoColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Ferramentas ativas"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Margin="0,0,0,6"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding FerramentasAtivas}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="{Binding FerramentasTendencia}"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource SuccessStrongColor}" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Locações em andamento -->
                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="220"
                        Margin="0,0,16,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">

                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource InfoBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material CalendarToday}"
                                    IconSize="22"
                                    IconColor="{StaticResource InfoColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Locações em andamento"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Margin="0,0,0,6"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding LocacoesEmAndamento}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="{Binding LocacoesLegenda}"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    TextColor="{StaticResource TextMutedColor}" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Solicitações pendentes -->
                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="220"
                        Margin="0,0,16,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">

                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource WarningBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Schedule}"
                                    IconSize="22"
                                    IconColor="{StaticResource WarningColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Solicitações pendentes"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Margin="0,0,0,6"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding SolicitacoesPendentes}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="Aguardando sua resposta"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    TextColor="{StaticResource TextMutedColor}" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Faturamento do mês -->
                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="220"
                        Margin="0,0,16,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">

                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SuccessBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Payments}"
                                    IconSize="22"
                                    IconColor="{StaticResource SuccessStrongColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Faturamento do mês"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Margin="0,0,0,6"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding FaturamentoMes}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="{Binding FaturamentoTendencia}"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource SuccessStrongColor}" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Avaliação média -->
                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="220"
                        Margin="0,0,16,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">

                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource WarningBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Star}"
                                    IconSize="22"
                                    IconColor="{StaticResource StarColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Avaliação média"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Margin="0,0,0,6"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding AvaliacaoMedia}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <HorizontalStackLayout
                                    Spacing="6"
                                    Margin="0,4,0,0">

                                    <avaliacoes:EstrelasAvaliacao
                                        Nota="{Binding AvaliacaoNota}" />

                                    <Label
                                        Text="{Binding TotalAvaliacoes}"
                                        FontSize="12"
                                        VerticalOptions="Center"
                                        TextColor="{StaticResource TextMutedColor}" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </FlexLayout>

                <!-- ── Solicitações Recentes / Agenda da Semana ───────────── -->
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">

                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="360"
                        Margin="0,0,20,20"
                        Padding="20"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <VerticalStackLayout Spacing="0">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                Margin="0,0,0,12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="2">

                                    <Label
                                        Text="Solicitações Recentes"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimaryColor}" />

                                    <Label
                                        Text="Confira as últimas solicitações de locação das suas ferramentas."
                                        FontSize="13"
                                        TextColor="{StaticResource TextMutedColor}" />

                                </VerticalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Start">

                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding VerTodasSolicitacoesCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>

                                    <Label
                                        Text="Ver todas"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                    <mi:MauiIcon
                                        Icon="{mi:Material ArrowForward}"
                                        IconSize="16"
                                        IconColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>
                            </Grid>

                            <Label
                                Text="Nenhuma solicitação por aqui ainda."
                                IsVisible="{Binding SemSolicitacoes}"
                                Padding="0,24"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource TextMutedColor}" />

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding SolicitacoesRecentes}"
                                IsVisible="{Binding TemSolicitacoes}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="modelsLocacoes:Locacao">

                                        <!-- Agora declaramos explicitamente a imagem aqui (vinda do modelo Locacao) -->
                                        <home:HomeLocadorSolicitacaoItem
                                            Imagem="{Binding Imagem}"
                                            VerDetalhesCommand="{Binding BindingContext.VerDetalhesSolicitacaoCommand, Source={x:Reference Pagina}}" 
                                        />

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Basis="360"
                        Margin="0,0,0,20"
                        Padding="20"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <VerticalStackLayout Spacing="0">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                Margin="0,0,0,12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="2">

                                    <Label
                                        Text="Agenda da Semana"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimaryColor}" />

                                    <Label
                                        Text="Próximos movimentos logísticos das suas ferramentas."
                                        FontSize="13"
                                        TextColor="{StaticResource TextMutedColor}" />

                                </VerticalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    Opacity="0.8"
                                    VerticalOptions="Start">

                                    <Label
                                        Text="Ver agenda completa"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                    <mi:MauiIcon
                                        Icon="{mi:Material ArrowForward}"
                                        IconSize="16"
                                        IconColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>
                            </Grid>

                            <Label
                                Text="Nenhum movimento logístico previsto no momento."
                                IsVisible="{Binding SemAgenda}"
                                Padding="0,24"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource TextMutedColor}" />

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding AgendaSemana}"
                                IsVisible="{Binding TemAgenda}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="modelsHome:AgendaSemanaLocadorItem">

                                        <home:HomeLocadorAgendaItem />

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </FlexLayout>

                <!-- ── Minhas Ferramentas ────────────────────────────────── -->
                <Border
                    Padding="20"
                    StrokeThickness="1"
                    Stroke="{StaticResource CardBorderColor}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                    <VerticalStackLayout Spacing="0">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            Margin="0,0,0,12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="Minhas Ferramentas"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="Acesse e gerencie suas ferramentas cadastradas."
                                    FontSize="13"
                                    TextColor="{StaticResource TextMutedColor}" />

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Start">

                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding VerTodasFerramentasCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>

                                <Label
                                    Text="Ver todas"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AuthSecondaryColor}"
                                    VerticalOptions="Center" />

                                <mi:MauiIcon
                                    Icon="{mi:Material ArrowForward}"
                                    IconSize="16"
                                    IconColor="{StaticResource AuthSecondaryColor}"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Carrossel horizontal -->
                        <ScrollView
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">

                            <HorizontalStackLayout
                                Spacing="20"
                                Padding="0,0,0,4">

                                <!-- Lista de ferramentas -->
                                <HorizontalStackLayout
                                    Spacing="20"
                                    BindableLayout.ItemsSource="{Binding MinhasFerramentas}">

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="modelsFerramentas:ProdutoHome">

                                            <ferramentas:ProductCard
                                                WidthRequest="210"
                                                Title="{Binding Title}"
                                                Brand="{Binding Locador}"
                                                Price="{Binding Price}"
                                                Imagem="{Binding Imagem}"
                                                Rating="{Binding RatingTexto}"
                                                ReviewCount="{Binding ReviewCount}"
                                                Status="{Binding Status}"
                                                MostrarAcoes="True"
                                                CommandParameter="{Binding Id}"
                                                VerCommand="{Binding BindingContext.VerFerramentaCommand, Source={x:Reference Pagina}}"
                                                EditarCommand="{Binding BindingContext.EditarFerramentaCommand, Source={x:Reference Pagina}}" />

                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>

                                </HorizontalStackLayout>

                                <home:HomeLocadorCardNovaFerramenta
                                    WidthRequest="210"
                                    CadastrarCommand="{Binding CadastrarFerramentaCommand}" />

                            </HorizontalStackLayout>
                        </ScrollView>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>