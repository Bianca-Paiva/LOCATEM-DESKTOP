<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="LOCATEM_DESKTOP.Views.Home.HomeLocadorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:layout="clr-namespace:LOCATEM_DESKTOP.Components.Layout"
    xmlns:shared="clr-namespace:LOCATEM_DESKTOP.Components.Shared"
    xmlns:ferramentas="clr-namespace:LOCATEM_DESKTOP.Components.Ferramentas"
    xmlns:home="clr-namespace:LOCATEM_DESKTOP.Components.Home.HomeLocador"
    xmlns:modelsFerramentas="clr-namespace:LOCATEM_DESKTOP.Models.Ferramentas"
    xmlns:modelsLocacoes="clr-namespace:LOCATEM_DESKTOP.Models.Locacoes"
    xmlns:modelsHome="clr-namespace:LOCATEM_DESKTOP.Models.Home"
    xmlns:avaliacoes="clr-namespace:LOCATEM_DESKTOP.Components.Avaliacoes"
    xmlns:vm="clr-namespace:LOCATEM_DESKTOP.ViewModels.Home"
    x:Name="Pagina"
    x:DataType="vm:HomeLocadorViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AuthBackgroundColor}">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- =========================================================
                 HEADER
                 ========================================================= -->

            <layout:AppHeader
                RotaAtual="homeLocador"
                NomeUsuario="{Binding NomeUsuario}"
                FotoUsuario="{Binding FotoUsuario}"
                NavegarCommand="{Binding NavegarCommand}" />


            <!-- =========================================================
                 CONTEÚDO DA PÁGINA
                 ========================================================= -->

            <VerticalStackLayout
                Padding="24,20,24,48"
                Spacing="24"
                MaximumWidthRequest="2000">

                <shared:CabecalhoPagina
                    Titulo="{Binding Saudacao}"
                    Subtitulo="{Binding Subtitulo}" />


                <!-- =====================================================
                     CARDS DE RESUMO
                     ===================================================== -->

                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Stretch">


                    <!-- =================================================
                         FERRAMENTAS ATIVAS
                         ================================================= -->

                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Shrink="1"
                        FlexLayout.Basis="230"
                        MinimumWidthRequest="210"
                        Margin="0,0,12,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14">

                            <!-- Ícone -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource InfoBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Build}"
                                    IconSize="22"
                                    IconColor="{StaticResource InfoColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- Informações -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Ferramentas ativas"
                                    FontSize="13"
                                    FontFamily="InterBold"
                                    Margin="0,0,0,6"
                                    LineBreakMode="WordWrap"
                                    MaxLines="2"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding FerramentasAtivas}"
                                    FontSize="26"
                                    FontFamily="InterBold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="{Binding FerramentasTendencia}"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontFamily="InterBold"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource SuccessStrongColor}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>


                    <!-- =================================================
                         LOCAÇÕES EM ANDAMENTO
                         ================================================= -->

                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Shrink="1"
                        FlexLayout.Basis="230"
                        MinimumWidthRequest="210"
                        Margin="0,0,12,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14">

                            <!-- Ícone -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource InfoBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material CalendarToday}"
                                    IconSize="22"
                                    IconColor="{StaticResource InfoColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- Informações -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Locações em andamento"
                                    FontSize="13"
                                    FontFamily="InterBold"
                                    Margin="0,0,0,6"
                                    LineBreakMode="WordWrap"
                                    MaxLines="2"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding LocacoesEmAndamento}"
                                    FontSize="26"
                                    FontFamily="InterBold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="{Binding LocacoesLegenda}"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource TextMutedColor}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>


                    <!-- =================================================
                         SOLICITAÇÕES PENDENTES
                         ================================================= -->

                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Shrink="1"
                        FlexLayout.Basis="230"
                        MinimumWidthRequest="210"
                        Margin="0,0,12,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14">

                            <!-- Ícone -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource WarningBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Schedule}"
                                    IconSize="22"
                                    IconColor="{StaticResource WarningColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- Informações -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Solicitações pendentes"
                                    FontSize="13"
                                    FontFamily="InterBold"
                                    Margin="0,0,0,6"
                                    LineBreakMode="WordWrap"
                                    MaxLines="2"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding SolicitacoesPendentes}"
                                    FontSize="26"
                                    FontFamily="InterBold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="Aguardando sua resposta"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource TextMutedColor}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>


                    <!-- =================================================
                         FATURAMENTO DO MÊS
                         ================================================= -->

                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Shrink="1"
                        FlexLayout.Basis="230"
                        MinimumWidthRequest="210"
                        Margin="0,0,12,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14">

                            <!-- Ícone -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SuccessBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Payments}"
                                    IconSize="22"
                                    IconColor="{StaticResource SuccessStrongColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- Informações -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Faturamento do mês"
                                    FontSize="13"
                                    FontFamily="InterBold"
                                    Margin="0,0,0,6"
                                    LineBreakMode="WordWrap"
                                    MaxLines="2"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding FaturamentoMes}"
                                    FontSize="26"
                                    FontFamily="InterBold"
                                    LineBreakMode="NoWrap"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="{Binding FaturamentoTendencia}"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontFamily="InterBold"
                                    LineBreakMode="WordWrap"
                                    TextColor="{StaticResource SuccessStrongColor}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>


                    <!-- =================================================
                         AVALIAÇÃO MÉDIA
                         ================================================= -->

                    <Border
                        FlexLayout.Grow="1"
                        FlexLayout.Shrink="1"
                        FlexLayout.Basis="230"
                        MinimumWidthRequest="210"
                        Margin="0,0,12,16"
                        Padding="20,18"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14">

                            <!-- Ícone -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource WarningBackgroundColor}"
                                VerticalOptions="Start">

                                <mi:MauiIcon
                                    Icon="{mi:Material Star}"
                                    IconSize="22"
                                    IconColor="{StaticResource StarColor}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- Informações -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="0">

                                <Label
                                    Text="Avaliação média"
                                    FontSize="13"
                                    FontFamily="InterBold"
                                    Margin="0,0,0,6"
                                    LineBreakMode="WordWrap"
                                    MaxLines="2"
                                    TextColor="{StaticResource TextMutedColor}" />

                                <Label
                                    Text="{Binding AvaliacaoMedia}"
                                    FontSize="26"
                                    FontFamily="InterBold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <!--
                                    FlexLayout em vez de HorizontalStackLayout.
                                    Se não houver espaço, o total de avaliações
                                    vai automaticamente para baixo.
                                -->
                                <FlexLayout
                                    Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Center"
                                    JustifyContent="Start"
                                    Margin="0,4,0,0">

                                    <avaliacoes:EstrelasAvaliacao
                                        Nota="{Binding AvaliacaoNota}"
                                        Margin="0,0,6,4" />

                                    <Label
                                        Text="{Binding TotalAvaliacoes}"
                                        FontSize="12"
                                        Margin="0,0,0,4"
                                        VerticalOptions="Center"
                                        TextColor="{StaticResource TextMutedColor}" />

                                </FlexLayout>

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </FlexLayout>


                <!-- =====================================================
                     SOLICITAÇÕES RECENTES / AGENDA DA SEMANA
                     ===================================================== -->

                <Grid
                    x:Name="PainelOperacionalGrid"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="20"
                    RowSpacing="20"
                    SizeChanged="PainelOperacionalGrid_SizeChanged">


                    <!-- =================================================
                         SOLICITAÇÕES RECENTES
                         ================================================= -->

                    <Border
                        x:Name="SolicitacoesRecentesCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="20"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <VerticalStackLayout Spacing="0">

                            <!-- Cabeçalho -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                Margin="0,0,0,12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="2">

                                    <Label
                                        Text="Solicitações Recentes"
                                        FontSize="15"
                                        FontFamily="InterBold"
                                        TextColor="{StaticResource TextPrimaryColor}" />

                                    <Label
                                        Text="Confira as últimas solicitações de locação das suas ferramentas."
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        TextColor="{StaticResource TextMutedColor}" />

                                </VerticalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start">

                                    <HorizontalStackLayout.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Command="{Binding VerTodasSolicitacoesCommand}" />

                                    </HorizontalStackLayout.GestureRecognizers>

                                    <Label
                                        Text="Ver todas"
                                        FontSize="13"
                                        FontFamily="InterBold"
                                        LineBreakMode="NoWrap"
                                        TextColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                    <mi:MauiIcon
                                        Icon="{mi:Material ArrowForward}"
                                        IconSize="16"
                                        IconColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>

                            </Grid>


                            <!-- Estado vazio -->
                            <Label
                                Text="Nenhuma solicitação por aqui ainda."
                                IsVisible="{Binding SemSolicitacoes}"
                                Padding="0,24"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource TextMutedColor}" />


                            <!-- Lista -->
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding SolicitacoesRecentes}"
                                IsVisible="{Binding TemSolicitacoes}">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="modelsLocacoes:Locacao">

                                        <home:HomeLocadorSolicitacaoItem
                                            Imagem="{Binding Imagem}"
                                            VerDetalhesCommand="{Binding BindingContext.VerDetalhesSolicitacaoCommand, Source={x:Reference Pagina}}" />

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>


                    <!-- =================================================
                         AGENDA DA SEMANA
                         ================================================= -->

                    <Border
                        x:Name="AgendaSemanaCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="20"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                        <VerticalStackLayout Spacing="0">

                            <!-- Cabeçalho -->
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                Margin="0,0,0,12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="2">

                                    <Label
                                        Text="Agenda da Semana"
                                        FontSize="15"
                                        FontFamily="InterBold"
                                        TextColor="{StaticResource TextPrimaryColor}" />

                                    <Label
                                        Text="Próximos movimentos logísticos das suas ferramentas."
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        TextColor="{StaticResource TextMutedColor}" />

                                </VerticalStackLayout>

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start">

                                    <Label
                                        Text="Ver agenda completa"
                                        FontSize="13"
                                        FontFamily="InterBold"
                                        LineBreakMode="NoWrap"
                                        TextColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                    <mi:MauiIcon
                                        Icon="{mi:Material ArrowForward}"
                                        IconSize="16"
                                        IconColor="{StaticResource AuthSecondaryColor}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>

                            </Grid>


                            <!-- Estado vazio -->
                            <Label
                                Text="Nenhum movimento logístico previsto no momento."
                                IsVisible="{Binding SemAgenda}"
                                Padding="0,24"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource TextMutedColor}" />


                            <!-- Lista -->
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding AgendaSemana}"
                                IsVisible="{Binding TemAgenda}">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="modelsHome:AgendaSemanaLocadorItem">

                                        <home:HomeLocadorAgendaItem />

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- =====================================================
                     MINHAS FERRAMENTAS
                     ===================================================== -->

                <Border
                    Padding="20"
                    StrokeThickness="1"
                    Stroke="{StaticResource CardBorderColor}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource AuthCardBackgroundColor}">

                    <VerticalStackLayout Spacing="0">

                        <!-- Cabeçalho -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            Margin="0,0,0,12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="Minhas Ferramentas"
                                    FontSize="15"
                                    FontFamily="InterBold"
                                    TextColor="{StaticResource TextPrimaryColor}" />

                                <Label
                                    Text="Acesse e gerencie suas ferramentas cadastradas."
                                    FontSize="13"
                                    TextColor="{StaticResource TextMutedColor}" />

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Start">

                                <HorizontalStackLayout.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Command="{Binding VerTodasFerramentasCommand}" />

                                </HorizontalStackLayout.GestureRecognizers>

                                <Label
                                    Text="Ver todas"
                                    FontSize="13"
                                    FontFamily="InterBold"
                                    TextColor="{StaticResource AuthSecondaryColor}"
                                    VerticalOptions="Center" />

                                <mi:MauiIcon
                                    Icon="{mi:Material ArrowForward}"
                                    IconSize="16"
                                    IconColor="{StaticResource AuthSecondaryColor}"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </Grid>


                        <!-- Carrossel horizontal -->
                        <ScrollView
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">

                            <HorizontalStackLayout
                                Spacing="20"
                                Padding="0,0,0,4">

                                <!-- Lista de ferramentas -->
                                <HorizontalStackLayout
                                    Spacing="20"
                                    BindableLayout.ItemsSource="{Binding MinhasFerramentas}">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="modelsFerramentas:ProdutoHome">

                                            <ferramentas:ProductCard
                                                WidthRequest="210"
                                                Title="{Binding Title}"
                                                Brand="{Binding Locador}"
                                                Price="{Binding Price}"
                                                Imagem="{Binding Imagem}"
                                                Rating="{Binding RatingTexto}"
                                                ReviewCount="{Binding ReviewCount}"
                                                Status="{Binding Status}"
                                                MostrarAcoes="True"
                                                CommandParameter="{Binding Id}"
                                                VerCommand="{Binding BindingContext.VerFerramentaCommand, Source={x:Reference Pagina}}"
                                                EditarCommand="{Binding BindingContext.EditarFerramentaCommand, Source={x:Reference Pagina}}" />

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </HorizontalStackLayout>


                                <!-- Novo anúncio -->
                                <home:HomeLocadorCardNovaFerramenta
                                    WidthRequest="210"
                                    CadastrarCommand="{Binding CadastrarFerramentaCommand}" />

                            </HorizontalStackLayout>

                        </ScrollView>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>