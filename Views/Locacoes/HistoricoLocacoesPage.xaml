<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="LOCATEM_DESKTOP.Views.Locacoes.HistoricoLocacoesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layout="clr-namespace:LOCATEM_DESKTOP.Components.Layout"
    xmlns:shared="clr-namespace:LOCATEM_DESKTOP.Components.Shared"
    xmlns:historico="clr-namespace:LOCATEM_DESKTOP.Components.Locacoes.Historico"
    xmlns:models="clr-namespace:LOCATEM_DESKTOP.Models.Locacoes"
    xmlns:vm="clr-namespace:LOCATEM_DESKTOP.ViewModels.Locacoes"
    x:DataType="vm:HistoricoLocacoesViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AuthBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <layout:AppHeader
                RotaAtual="historicoLocacoes"
                NomeUsuario="{Binding NomeUsuario}"
                FotoUsuario="{Binding FotoUsuario}"
                NavegarCommand="{Binding NavegarCommand}" />

            <!-- Mantém o mesmo limite e espaçamento responsivo das telas de locações do Desktop. -->
            <VerticalStackLayout
                x:Name="ConteudoPagina"
                Padding="24,20,24,48"
                Spacing="0">

                <shared:CabecalhoPagina
                    Titulo="Histórico de Locações"
                    Subtitulo="Acompanhe todas as locações encerradas das suas ferramentas."
                    Margin="0,0,0,30" />

                <shared:Abas
                    ItemsSource="{Binding Abas}"
                    SelecionarCommand="{Binding SelecionarAbaCommand}"
                    Margin="0,0,0,20" />

                <shared:EstadoVazio
                    Titulo="Nenhuma locação no histórico"
                    Descricao="Locações finalizadas, recusadas ou canceladas aparecerão aqui."
                    IsVisible="{Binding SemLocacoes}" />

                <VerticalStackLayout
                    Spacing="14"
                    IsVisible="{Binding TemLocacoes}"
                    BindableLayout.ItemsSource="{Binding Locacoes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Locacao">
                            <historico:LocacaoHistoricoCard Locacao="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
