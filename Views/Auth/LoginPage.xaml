<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="LOCATEM_DESKTOP.Views.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:layout="clr-namespace:LOCATEM_DESKTOP.Components.Layout"
    xmlns:shared="clr-namespace:LOCATEM_DESKTOP.Components.Shared"
    xmlns:vm="clr-namespace:LOCATEM_DESKTOP.ViewModels.Auth"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AuthBackgroundColor}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <layout:AuthHeader />

                <shared:PageHeader 
                    Title="Bem-vindo de volta!" 
                    Subtitle="Entre na sua conta para continuar" 
                />

                <Border Margin="20,10,20,40"
                        MaximumWidthRequest="560"
                        HorizontalOptions="Fill"
                        Padding="40"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        BackgroundColor="{StaticResource AuthCardBackgroundColor}"
                >
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="25" Offset="0,10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="25">
                            <shared:FormEntry 
                                Label="E-mail"
                                Text="{Binding Email}"
                                Placeholder="seu@email.com"
                                EntryKeyboard="Email"
                                IsRequiredField="True"
                                ErrorText="{Binding EmailErrorText}"
                                IsShaking="{Binding EmailError.Shake}"
                                Status="{Binding EmailError.Active, Converter={StaticResource ErrorActiveToStatusConverter}}" 
                            />

                            <shared:PasswordEntry 
                                Label="Senha"
                                Text="{Binding Senha}"
                                Placeholder="Digite sua senha"
                                IsRequiredField="True"
                                ErrorText="{Binding SenhaErrorText}"
                                IsShaking="{Binding SenhaError.Shake}"
                                Status="{Binding SenhaError.Active, Converter={StaticResource ErrorActiveToStatusConverter}}" 
                            />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasError}" ColumnSpacing="8">
                            <mi:MauiIcon Grid.Column="0" Icon="{mi:Material ErrorOutline}" IconSize="16" IconColor="{StaticResource ErrorStrongColor}" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Não foi possível entrar" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ErrorStrongColor}" />
                                <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource ErrorTextColor}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Text="Esqueceu sua senha?"
                            FontSize="14"
                            FontFamily="InterRegular"
                            TextDecorations="Underline"
                            TextColor="{StaticResource TextPrimaryColor}"
                            HorizontalOptions="End"
                        >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EsqueceuSenhaCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Button 
                            Text="{Binding IsBusy, Converter={StaticResource BusyToLoginTextConverter}}"
                            Style="{StaticResource BtnPrincipalStyle}"
                            FontFamily="InterBold"
                            Command="{Binding EntrarCommand}"
                            IsEnabled="{Binding IsNotBusy}" 
                        />

                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,10,0,0">
                            <Label Text="Não tem uma conta?" FontSize="14" FontFamily="InterRegular" TextColor="{StaticResource TextBodyColor}" VerticalOptions="Center" />
                            <Label Text="Criar conta" FontSize="14" FontFamily="InterBold" TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CriarContaCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
                    
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
