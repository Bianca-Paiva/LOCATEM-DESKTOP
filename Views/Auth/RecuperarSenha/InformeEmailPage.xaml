<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage
    x:Class="LOCATEM_DESKTOP.Views.Auth.RecuperarSenha.InformeEmailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layout="clr-namespace:LOCATEM_DESKTOP.Components.Layout"
    xmlns:shared="clr-namespace:LOCATEM_DESKTOP.Components.Shared"
    xmlns:recuperar="clr-namespace:LOCATEM_DESKTOP.Components.Auth.RecuperarSenha"
    xmlns:vm="clr-namespace:LOCATEM_DESKTOP.ViewModels.Auth"
    x:DataType="vm:InformeEmailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AuthBackgroundColor}">

    <ScrollView>

        <VerticalStackLayout
            Spacing="0"
            Padding="0,0,0,40">

            <!-- Header -->
            <layout:AuthHeader />

            <!-- Etapas da recuperação de senha -->
            <recuperar:RecoveryStepper
                CurrentStep="1"
                HorizontalOptions="Center" />

            <!-- Título e subtítulo -->
            <shared:PageHeader
                Title="Informe seu e-mail"
                Subtitle="Digite o e-mail associado à sua conta. Enviaremos um token para recuperação da senha." />


            <!--
                CONTEÚDO PRINCIPAL
                Mantém apenas formulário/suporte/divisor limitados a 500px.
            -->
            <VerticalStackLayout
                Spacing="20"
                MaximumWidthRequest="500"
                WidthRequest="500"
                HorizontalOptions="Center"
                Padding="20,0"
                Margin="0,24,0,0">

                <!-- Campo de e-mail -->
                <shared:FormEntry
                    Label="E-mail"
                    Text="{Binding Email}"
                    Placeholder="seu@email.com"
                    EntryKeyboard="Email"
                    IsRequiredField="True"
                    ErrorText="{Binding EmailErrorText}"
                    IsShaking="{Binding EmailError.Shake}"
                    Status="{Binding EmailError.Active, Converter={StaticResource ErrorActiveToStatusConverter}}" />

                <!-- Enviar e-mail -->
                <Button
                    Text="Enviar e-mail"
                    Style="{StaticResource BtnPrincipalStyle}"
                    Command="{Binding EnviarEmailCommand}" />

                <!-- Suporte -->
                <recuperar:FooterLink
                    Text="Precisa de ajuda?"
                    LinkText="Entre em contato com o suporte."
                    Command="{Binding ContatoSuporteCommand}"
                    Margin="0,24,0,0" />

                <!-- Divisor "ou" -->
                <Grid
                    ColumnDefinitions="*,Auto,*"
                    ColumnSpacing="12"
                    Margin="0,16">

                    <BoxView
                        Grid.Column="0"
                        HeightRequest="1"
                        Color="#E0E0E0"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="ou"
                        FontSize="14"
                        TextColor="#8A8A8A"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                    <BoxView
                        Grid.Column="2"
                        HeightRequest="1"
                        Color="#E0E0E0"
                        VerticalOptions="Center" />

                </Grid>

            </VerticalStackLayout>


            <!--
                RODAPÉ DE LOGIN/CADASTRO

                Fica FORA do container de 500px para não ser cortado.
            -->
            <Grid
                ColumnDefinitions="Auto,Auto,Auto"
                ColumnSpacing="16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="20,24,20,0">

                <!-- Login -->
                <recuperar:FooterLink
                    Grid.Column="0"
                    Text="Lembrou sua senha?"
                    LinkText="Entrar na minha conta"
                    Command="{Binding IrParaLoginCommand}"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />

                <!-- Separador -->
                <Label
                    Grid.Column="1"
                    Text="•"
                    FontSize="14"
                    TextColor="{StaticResource TextSecondaryMutedColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <!-- Cadastro -->
                <recuperar:FooterLink
                    Grid.Column="2"
                    Text="Ainda não tem conta?"
                    LinkText="Criar nova conta"
                    Command="{Binding IrParaCadastroCommand}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>