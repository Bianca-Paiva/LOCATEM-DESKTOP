<?xml version='1.0' encoding='UTF-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:layout="clr-namespace:LOCATEM_DESKTOP.Components.Layout" xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons" xmlns:shared="clr-namespace:LOCATEM_DESKTOP.Components.Shared" xmlns:vm="clr-namespace:LOCATEM_DESKTOP.ViewModels.Ferramentas" x:Class="LOCATEM_DESKTOP.Views.Ferramentas.CadastroFerramentaPage" x:Name="Pagina" x:DataType="vm:CadastroFerramentaViewModel" Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource AuthBackgroundColor}">
    <ContentPage.Resources>
        <!-- Cores e contornos dos campos, seguindo os componentes FormInput do Web. -->
        <Color x:Key="CorIconeSecao">#8A6D00</Color>
        <Style x:Key="CampoBorda" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource InputBorderColor}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="BackgroundColor" Value="{StaticResource AuthInputBackgroundColor}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HeightRequest" Value="48"/>
        </Style>
        <Style x:Key="EditorBorda" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource InputBorderColor}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="BackgroundColor" Value="{StaticResource AuthInputBackgroundColor}"/>
            <Setter Property="Padding" Value="14,2"/>
        </Style>
        <Style x:Key="TextoAjuda" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="InterRegular"/>
            <Setter Property="TextColor" Value="{StaticResource TextMutedColor}"/>
        </Style>
        <Style x:Key="BadgeFoto" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
            <Setter Property="BackgroundColor" Value="#F1F1F1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="BadgeFotoTexto" TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="InterSemiBold"/>
            <Setter Property="TextColor" Value="{StaticResource TextMutedColor}"/>
        </Style>
        <Style x:Key="ChipFonte" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AuthInputBackgroundColor}"/>
            <Setter Property="BorderColor" Value="{StaticResource InputBorderColor}"/>
            <Setter Property="BorderWidth" Value="1.5"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="InterMedium"/>
            <Setter Property="TextColor" Value="#374151"/>
        </Style>
        <!-- Cartões selecionáveis da aprovação e elementos auxiliares do calendário. -->
        <Style x:Key="OpcaoAprovacao" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource InputBorderColor}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="BackgroundColor" Value="{StaticResource AuthInputBackgroundColor}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="LegendaColuna" TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="InterBold"/>
            <Setter Property="TextColor" Value="{StaticResource TextMutedColor}"/>
        </Style>
        <Style x:Key="DiaSemana" TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="InterBold"/>
            <Setter Property="TextColor" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BotaoMes" TargetType="Button">
            <Setter Property="WidthRequest" Value="30"/>
            <Setter Property="HeightRequest" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
        </Style>
        <Style x:Key="BotaoStepper" TargetType="Button">
            <Setter Property="WidthRequest" Value="34"/>
            <Setter Property="HeightRequest" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
        </Style>
        <Style x:Key="Secao" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource AuthCardBackgroundColor}"/>
            <Setter Property="Stroke" Value="#EEEEEE"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <!-- Tipografia comum aos cabeçalhos e campos das nove seções. -->
        <Style x:Key="TituloSecao" TargetType="Label">
            <Setter Property="FontFamily" Value="InterBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
        </Style>
        <Style x:Key="SubtituloSecao" TargetType="Label">
            <Setter Property="FontFamily" Value="InterRegular"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="{StaticResource TextMutedColor}"/>
        </Style>
        <Style x:Key="Rotulo" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="#141D23"/>
        </Style>
        <Style x:Key="Campo" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="PlaceholderColor" Value="{StaticResource TextMutedColor}"/>
            <Setter Property="HeightRequest" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="InterRegular"/>
        </Style>
        <Style x:Key="Escolha" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="{StaticResource AuthInputBackgroundColor}"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="HeightRequest" Value="48"/>
            <Setter Property="MinimumHeightRequest" Value="48"/>
            <Setter Property="FontFamily" Value="InterMedium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        <Style x:Key="AcaoMenor" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource AuthPrimarySoftColor}"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="FontFamily" Value="InterMedium"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </ContentPage.Resources>
    <!-- Mantém cabeçalho, formulário e ações numa única rolagem. -->
    <ScrollView x:Name="PaginaScroll">
        <VerticalStackLayout Spacing="0">
            <layout:AppHeader RotaAtual="minhasFerramentas" NomeUsuario="{Binding NomeUsuario}" FotoUsuario="{Binding FotoUsuario}" NavegarCommand="{Binding NavegarCommand}"/>
            <VerticalStackLayout x:Name="Conteudo" Padding="24,20,24,48" MaximumWidthRequest="1300">
                <shared:CabecalhoPagina x:Name="CabecalhoCadastro" Titulo="{Binding Titulo}" FonteTitulo="InterExtraBold" TamanhoTitulo="28" Subtitulo="Preencha as informações abaixo para publicar sua ferramenta para aluguel." Margin="0,0,0,30"/>
                <Border BackgroundColor="{StaticResource ErrorBackgroundColor}" Stroke="{StaticResource ErrorBorderColor}" Padding="14" Margin="0,16,0,16" IsVisible="{Binding TemErro}">
                    <Label Text="{Binding Erro}" TextColor="{StaticResource ErrorColor}"/>
                </Border>
                <!-- A proporção das colunas segue a grade Web; o code-behind as empilha abaixo de 1024. -->
                <Grid x:Name="Colunas" ColumnDefinitions="1.3*,0.7*" ColumnSpacing="24" RowDefinitions="Auto,Auto">
                    <VerticalStackLayout x:Name="ColunaEsquerda" Grid.Column="0" Spacing="0">
                        <!-- Fotos: área tracejada abre o seletor nativo; miniaturas preservam as ações existentes. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material PhotoCamera}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Fotos da Ferramenta *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Adicione fotos de qualidade para atrair mais locatários." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="16">
                                    <Border Stroke="#D8D8D8" StrokeThickness="1.5" StrokeDashArray="5,4" StrokeShape="RoundRectangle 14" BackgroundColor="#FCFCFC" Padding="16,28">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AdicionarFotosCommand}"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource AuthPrimarySoftColor}" HorizontalOptions="Center" Margin="0,0,0,14">
                                                <mi:MauiIcon Icon="{mi:Material FileUpload}" IconSize="26" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <Label Text="Adicione fotos da ferramenta aqui" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource TextPrimaryColor}" HorizontalTextAlignment="Center"/>
                                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,4,0,16">
                                                <Label Text="ou" FontSize="13" TextColor="{StaticResource TextMutedColor}"/>
                                                <Label Text="clique para selecionar" FontSize="13" FontFamily="InterSemiBold" TextColor="#B8860B" TextDecorations="Underline"/>
                                            </HorizontalStackLayout>
                                            <FlexLayout Wrap="Wrap" JustifyContent="Center" Direction="Row">
                                                <Border Style="{StaticResource BadgeFoto}">
                                                    <Label Text="{Binding Fotos.Count, StringFormat='Até 8 fotos — {0}/8 adicionadas'}" Style="{StaticResource BadgeFotoTexto}"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeFoto}">
                                                    <Label Text="Mínimo 1 foto obrigatória" Style="{StaticResource BadgeFotoTexto}"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeFoto}">
                                                    <Label Text="A 1ª foto será a capa — use Tornar capa para reordenar" Style="{StaticResource BadgeFotoTexto}"/>
                                                </Border>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                    <FlexLayout BindableLayout.ItemsSource="{Binding Fotos}" Wrap="Wrap" Direction="Row">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Null}">
                                                <Border Stroke="{StaticResource CardBorderColor}" StrokeShape="RoundRectangle 8" Padding="6" Margin="0,0,8,8" WidthRequest="116">
                                                    <VerticalStackLayout Spacing="4">
                                                        <Image Source="{Binding Preview}" WidthRequest="100" HeightRequest="90" Aspect="AspectFill"/>
                                                        <Label Text="{Binding Nome}" LineBreakMode="TailTruncation" FontSize="11"/>
                                                        <Button Text="Tornar capa" FontSize="10" Padding="2" Style="{StaticResource AcaoMenor}" Command="{Binding BindingContext.MoverFotoCommand, Source={x:Reference Pagina}}" CommandParameter="{Binding .}"/>
                                                        <Button Text="Remover" FontSize="10" Padding="2" Style="{StaticResource AcaoMenor}" Command="{Binding BindingContext.RemoverFotoCommand, Source={x:Reference Pagina}}" CommandParameter="{Binding .}"/>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!-- Informações básicas: campos em pares, quantidade e opções de voltagem. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material Assignment}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Informações Básicas *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Dados principais da sua ferramenta." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="20">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Nome da Ferramenta *" Style="{StaticResource Rotulo}"/>
                                        <Border Style="{StaticResource CampoBorda}">
                                            <Entry Text="{Binding Nome}" Placeholder="Ex: Furadeira de Impacto 750W" Style="{StaticResource Campo}"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                        <VerticalStackLayout Grid.Column="0">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Marca *" Style="{StaticResource Rotulo}"/>
                                                <Border Style="{StaticResource CampoBorda}">
                                                    <Entry Text="{Binding Marca}" Placeholder="Ex: Bosch, Makita, DeWalt..." Style="{StaticResource Campo}"/>
                                                </Border>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Modelo *" Style="{StaticResource Rotulo}"/>
                                                <Border Style="{StaticResource CampoBorda}">
                                                    <Entry Text="{Binding Modelo}" Placeholder="Ex: GSB 13 RE" Style="{StaticResource Campo}"/>
                                                </Border>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                        <VerticalStackLayout Grid.Column="0">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Categoria *" Style="{StaticResource Rotulo}"/>
                                                <Grid>
                                                    <Picker Title="" ItemsSource="{Binding OpcoesCategorias}" SelectedItem="{Binding Categoria}" Style="{StaticResource Escolha}"/>
                                                    <Label Text="Selecione uma categoria" InputTransparent="True" IsVisible="False" FontSize="14" TextColor="{StaticResource TextMutedColor}" VerticalTextAlignment="Center" Margin="14,0,30,0">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Categoria}" Value="">
                                                                <Setter Property="IsVisible" Value="True"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Estado de Conservação *" Style="{StaticResource Rotulo}"/>
                                                <Grid>
                                                    <Picker Title="" ItemsSource="{Binding OpcoesEstados}" SelectedItem="{Binding EstadoConservacao}" Style="{StaticResource Escolha}"/>
                                                    <Label Text="Selecione o estado" InputTransparent="True" IsVisible="False" FontSize="14" TextColor="{StaticResource TextMutedColor}" VerticalTextAlignment="Center" Margin="14,0,30,0">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding EstadoConservacao}" Value="">
                                                                <Setter Property="IsVisible" Value="True"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                        <VerticalStackLayout Grid.Column="0">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Quantidade *" Style="{StaticResource Rotulo}"/>
                                                <Border Style="{StaticResource CampoBorda}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="46">
                                                        <Button Grid.Column="0" Text="−" Clicked="QuantidadeMenos_Clicked" Style="{StaticResource BotaoStepper}"/>
                                                        <Label Grid.Column="1" Text="{Binding QuantidadeDisponivel}" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource TextPrimaryColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                                        <Button Grid.Column="2" Text="+" Clicked="QuantidadeMais_Clicked" Style="{StaticResource BotaoStepper}"/>
                                                    </Grid>
                                                </Border>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="Fonte de Alimentação / Voltagem *" Style="{StaticResource Rotulo}"/>
                                            <FlexLayout Wrap="Wrap" Direction="Row">
                                                <Button Text="127V" Command="{Binding SelecionarFonteCommand}" CommandParameter="127V" Style="{StaticResource ChipFonte}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding FonteAlimentacao}" Value="127V">
                                                            <Setter Property="BackgroundColor" Value="#FFFBEB"/>
                                                            <Setter Property="BorderColor" Value="{StaticResource AuthPrimaryColor}"/>
                                                            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Text="220V" Command="{Binding SelecionarFonteCommand}" CommandParameter="220V" Style="{StaticResource ChipFonte}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding FonteAlimentacao}" Value="220V">
                                                            <Setter Property="BackgroundColor" Value="#FFFBEB"/>
                                                            <Setter Property="BorderColor" Value="{StaticResource AuthPrimaryColor}"/>
                                                            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Text="Bivolt" Command="{Binding SelecionarFonteCommand}" CommandParameter="Bivolt" Style="{StaticResource ChipFonte}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding FonteAlimentacao}" Value="Bivolt">
                                                            <Setter Property="BackgroundColor" Value="#FFFBEB"/>
                                                            <Setter Property="BorderColor" Value="{StaticResource AuthPrimaryColor}"/>
                                                            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Text="À bateria" Command="{Binding SelecionarFonteCommand}" CommandParameter="À bateria" Style="{StaticResource ChipFonte}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding FonteAlimentacao}" Value="À bateria">
                                                            <Setter Property="BackgroundColor" Value="#FFFBEB"/>
                                                            <Setter Property="BorderColor" Value="{StaticResource AuthPrimaryColor}"/>
                                                            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Text="Pneumática" Command="{Binding SelecionarFonteCommand}" CommandParameter="Pneumática" Style="{StaticResource ChipFonte}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding FonteAlimentacao}" Value="Pneumática">
                                                            <Setter Property="BackgroundColor" Value="#FFFBEB"/>
                                                            <Setter Property="BorderColor" Value="{StaticResource AuthPrimaryColor}"/>
                                                            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Text="Manual" Command="{Binding SelecionarFonteCommand}" CommandParameter="Manual" Style="{StaticResource ChipFonte}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding FonteAlimentacao}" Value="Manual">
                                                            <Setter Property="BackgroundColor" Value="#FFFBEB"/>
                                                            <Setter Property="BorderColor" Value="{StaticResource AuthPrimaryColor}"/>
                                                            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Text="Trifásica (380V)" Command="{Binding SelecionarFonteCommand}" CommandParameter="Trifásica (380V)" Style="{StaticResource ChipFonte}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding FonteAlimentacao}" Value="Trifásica (380V)">
                                                            <Setter Property="BackgroundColor" Value="#FFFBEB"/>
                                                            <Setter Property="BorderColor" Value="{StaticResource AuthPrimaryColor}"/>
                                                            <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}"/>
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!-- Descrição: editor e contador acompanham o limite de mil caracteres. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material Edit}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Descrição *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Descreva seu equipamento com detalhes para atrair locatários." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Descrição da Ferramenta *" Style="{StaticResource Rotulo}"/>
                                    <Border Style="{StaticResource EditorBorda}">
                                        <Editor Text="{Binding Descricao}" Placeholder="Descreva a ferramenta, estado de uso, recomendações e observações importantes." MaxLength="1000" HeightRequest="120" AutoSize="Disabled" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimaryColor}" PlaceholderColor="{StaticResource TextMutedColor}" FontFamily="InterRegular" FontSize="14"/>
                                    </Border>
                                    <Label Text="{Binding Descricao.Length, StringFormat='{0} / 1000'}" FontSize="12" TextColor="{StaticResource TextMutedColor}" HorizontalOptions="End" Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!-- Especificações: linhas editáveis e comandos para adicionar ou remover. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material Build}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Especificações Técnicas *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Adicione dados técnicos detalhados da ferramenta." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,*,34" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="ESPECIFICAÇÃO" Style="{StaticResource LegendaColuna}"/>
                                        <Label Grid.Column="1" Text="VALOR" Style="{StaticResource LegendaColuna}"/>
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Especificacoes}" Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Null}">
                                                <Grid ColumnDefinitions="*,*,34" ColumnSpacing="10">
                                                    <Border Grid.Column="0" Style="{StaticResource CampoBorda}">
                                                        <Entry Text="{Binding Label}" Placeholder="Torque máximo" Style="{StaticResource Campo}"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource CampoBorda}">
                                                        <Entry Text="{Binding Valor}" Placeholder="65 Nm" Style="{StaticResource Campo}"/>
                                                    </Border>
                                                    <Border Grid.Column="2" WidthRequest="34" HeightRequest="34" Margin="0,7,0,0" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FDECED">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.RemoverEspecificacaoCommand, Source={x:Reference Pagina}}" CommandParameter="{Binding .}"/>
                                                        </Border.GestureRecognizers>
                                                        <mi:MauiIcon Icon="{mi:Material DeleteOutline}" IconSize="16" IconColor="#E11D48" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Button Text="＋  Adicionar Especificação" Command="{Binding AdicionarEspecificacaoCommand}" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="{StaticResource CorIconeSecao}" FontFamily="InterBold" FontSize="13" Padding="2,6"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!-- Aprovação: os dois cartões alteram o mesmo valor salvo pelo ViewModel. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material CheckCircle}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Aprovação da locação *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Defina como as solicitações de locação serão aprovadas." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="10">
                                    <Border Style="{StaticResource OpcaoAprovacao}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding TipoAprovacao}" Value="Aprovação manual">
                                                <Setter Property="Stroke" Value="{StaticResource AuthPrimaryColor}"/>
                                                <Setter Property="BackgroundColor" Value="{StaticResource AuthPrimarySoftColor}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelecionarAprovacaoCommand}" CommandParameter="Aprovação manual"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="18,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" Stroke="{StaticResource TextMutedColor}" StrokeThickness="1.5" StrokeShape="RoundRectangle 9" VerticalOptions="Start" Margin="0,2,0,0">
                                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="{StaticResource AuthPrimaryColor}" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <BoxView.Triggers>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding TipoAprovacao}" Value="Aprovação manual">
                                                            <Setter Property="IsVisible" Value="True"/>
                                                        </DataTrigger>
                                                    </BoxView.Triggers>
                                                </BoxView>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="Aprovação manual" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource TextPrimaryColor}"/>
                                                    <Border BackgroundColor="{StaticResource AuthPrimaryColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,2">
                                                        <Label Text="Recomendado" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextPrimaryColor}"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Label Text="O locador analisa cada solicitação antes da confirmação." Style="{StaticResource TextoAjuda}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource OpcaoAprovacao}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding TipoAprovacao}" Value="Aprovação automática">
                                                <Setter Property="Stroke" Value="{StaticResource AuthPrimaryColor}"/>
                                                <Setter Property="BackgroundColor" Value="{StaticResource AuthPrimarySoftColor}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelecionarAprovacaoCommand}" CommandParameter="Aprovação automática"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="18,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" Stroke="{StaticResource TextMutedColor}" StrokeThickness="1.5" StrokeShape="RoundRectangle 9" VerticalOptions="Start" Margin="0,2,0,0">
                                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="{StaticResource AuthPrimaryColor}" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <BoxView.Triggers>
                                                        <DataTrigger TargetType="BoxView" Binding="{Binding TipoAprovacao}" Value="Aprovação automática">
                                                            <Setter Property="IsVisible" Value="True"/>
                                                        </DataTrigger>
                                                    </BoxView.Triggers>
                                                </BoxView>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label Text="Aprovação automática" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource TextPrimaryColor}"/>
                                                <Label Text="As locações são confirmadas automaticamente quando houver disponibilidade." Style="{StaticResource TextoAjuda}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="ColunaDireita" Grid.Column="1" Spacing="0">
                        <!-- Precificação: prefixo monetário e textos de apoio do formulário Web. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material Payments}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Precificação *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Defina os valores de locação e caução." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="20">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Valor da Diária *" Style="{StaticResource Rotulo}"/>
                                        <Border Style="{StaticResource CampoBorda}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Label Grid.Column="0" Text="R$" Style="{StaticResource TextoAjuda}" VerticalTextAlignment="Center"/>
                                                <Entry Grid.Column="1" Text="{Binding ValorDiaria}" Placeholder="Ex: 45,00" Keyboard="Numeric" Style="{StaticResource Campo}"/>
                                            </Grid>
                                        </Border>
                                        <Label Text="Valor cobrado por dia de locação." Style="{StaticResource TextoAjuda}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Caução (opcional)" Style="{StaticResource Rotulo}"/>
                                        <Border Style="{StaticResource CampoBorda}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Label Grid.Column="0" Text="R$" Style="{StaticResource TextoAjuda}" VerticalTextAlignment="Center"/>
                                                <Entry Grid.Column="1" Text="{Binding Caucao}" Placeholder="Ex: 200,00" Keyboard="Numeric" Style="{StaticResource Campo}"/>
                                            </Grid>
                                        </Border>
                                        <Label Text="Valor devolvido após a devolução da ferramenta." Style="{StaticResource TextoAjuda}"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!-- Acessórios: Enter adiciona um item e a lista mostra os itens incluídos. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material Inventory2}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Acessórios Inclusos" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Informe os itens que acompanham a ferramenta." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="10">
                                    <FlexLayout BindableLayout.ItemsSource="{Binding Acessorios}" Wrap="Wrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Null}">
                                                <Button Text="{Binding .}" Margin="0,0,6,6" Style="{StaticResource AcaoMenor}" Command="{Binding BindingContext.RemoverAcessorioCommand, Source={x:Reference Pagina}}" CommandParameter="{Binding .}"/>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    <Border Style="{StaticResource CampoBorda}">
                                        <Entry Text="{Binding AcessorioNovo}" Placeholder="Adicione" ReturnType="Done" Completed="Acessorio_Completed" Style="{StaticResource Campo}"/>
                                    </Border>
                                    <Label Text="Pressione Enter para adicionar cada acessório." Style="{StaticResource TextoAjuda}"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!-- Disponibilidade: grade mensal, estados dos dias e legenda. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material CalendarToday}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Disponibilidade *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Marque os dias em que a ferramenta não estará disponível." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="30,*,30">
                                        <Button Grid.Column="0" Text="‹" Command="{Binding MesAnteriorCommand}" Style="{StaticResource BotaoMes}"/>
                                        <Label Grid.Column="1" Text="{Binding MesTexto}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="15" FontFamily="InterBold" TextColor="{StaticResource TextPrimaryColor}"/>
                                        <Button Grid.Column="2" Text="›" Command="{Binding ProximoMesCommand}" Style="{StaticResource BotaoMes}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                        <Label Grid.Column="0" Text="Dom" Style="{StaticResource DiaSemana}"/>
                                        <Label Grid.Column="1" Text="Seg" Style="{StaticResource DiaSemana}"/>
                                        <Label Grid.Column="2" Text="Ter" Style="{StaticResource DiaSemana}"/>
                                        <Label Grid.Column="3" Text="Qua" Style="{StaticResource DiaSemana}"/>
                                        <Label Grid.Column="4" Text="Qui" Style="{StaticResource DiaSemana}"/>
                                        <Label Grid.Column="5" Text="Sex" Style="{StaticResource DiaSemana}"/>
                                        <Label Grid.Column="6" Text="Sáb" Style="{StaticResource DiaSemana}"/>
                                    </Grid>
                                    <CollectionView ItemsSource="{Binding Dias}" HeightRequest="{Binding AlturaCalendario}" SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4"/>
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Null}">
                                                <Border BackgroundColor="{Binding CorFundo}" Stroke="{Binding CorBorda}" StrokeThickness="1.5" StrokeShape="RoundRectangle 8" HeightRequest="48">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding BindingContext.AlternarDiaCommand, Source={x:Reference Pagina}}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Grid>
                                                        <Label Text="{Binding Texto}" TextColor="{Binding CorTexto}" FontSize="12" FontFamily="InterSemiBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                                        <BoxView IsVisible="{Binding Indisponivel}" WidthRequest="2" HeightRequest="64" Rotation="-45" BackgroundColor="#FF4D4D" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                    <BoxView HeightRequest="1" BackgroundColor="#F1F1F1"/>
                                    <FlexLayout Wrap="Wrap" Direction="Row">
                                        <HorizontalStackLayout Spacing="6" Margin="0,0,14,0">
                                            <Border WidthRequest="12" HeightRequest="12" Stroke="#22C55E" StrokeThickness="1.5" StrokeShape="RoundRectangle 4" BackgroundColor="#F2FBF5"/>
                                            <Label Text="Disponível" Style="{StaticResource TextoAjuda}"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" Margin="0,0,14,0">
                                            <Border WidthRequest="12" HeightRequest="12" Stroke="#FF4D4D" StrokeThickness="1.5" StrokeShape="RoundRectangle 4" BackgroundColor="#FFF5F5"/>
                                            <Label Text="Indisponível" Style="{StaticResource TextoAjuda}"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6">
                                            <Border WidthRequest="12" HeightRequest="12" Stroke="#E5E5E5" StrokeThickness="1.5" StrokeShape="RoundRectangle 4" BackgroundColor="#FAFAFA"/>
                                            <Label Text="Data passada" Style="{StaticResource TextoAjuda}"/>
                                        </HorizontalStackLayout>
                                    </FlexLayout>
                                    <Label Text="Clique em um dia para marcar como indisponível. Clique novamente para desmarcar." Style="{StaticResource TextoAjuda}" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <!-- Endereço: CEP, rua, número e complemento em campos proporcionais. -->
                        <Border Style="{StaticResource Secao}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource AuthPrimarySoftColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Start">
                                        <mi:MauiIcon Icon="{mi:Material LocationOn}" IconSize="20" IconColor="{StaticResource CorIconeSecao}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,2,0,0">
                                        <Label Text="Endereço de Retirada e Devolução *" Style="{StaticResource TituloSecao}"/>
                                        <Label Text="Local onde o locatário poderá retirar a ferramenta." Style="{StaticResource SubtituloSecao}"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="20">
                                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start" JustifyContent="SpaceBetween">
                                        <VerticalStackLayout WidthRequest="220">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="CEP *" Style="{StaticResource Rotulo}"/>
                                                <Border Style="{StaticResource CampoBorda}">
                                                    <Entry Text="{Binding Cep}" Placeholder="00000-000" Style="{StaticResource Campo}" Keyboard="Numeric" MaxLength="9"/>
                                                </Border>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Text="Não sei meu CEP"
                                           FontSize="13"
                                           FontFamily="InterSemiBold"
                                           TextColor="{StaticResource VerificadoColor}"
                                           TextDecorations="Underline"
                                           Margin="0,4,0,0">        
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="BuscarCep_Tapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </FlexLayout>
                                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                                        <VerticalStackLayout Grid.Column="0">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Rua / Avenida *" Style="{StaticResource Rotulo}"/>
                                                <Border Style="{StaticResource CampoBorda}">
                                                    <Entry Text="{Binding RuaAvenida}" Placeholder="Ex: Av. Paulista" Style="{StaticResource Campo}"/>
                                                </Border>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Número *" Style="{StaticResource Rotulo}"/>
                                                <Border Style="{StaticResource CampoBorda}">
                                                    <Entry Text="{Binding Numero}" Placeholder="Ex: 1234" Style="{StaticResource Campo}"/>
                                                </Border>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Complemento (opcional)" Style="{StaticResource Rotulo}"/>
                                        <Border Style="{StaticResource EditorBorda}">
                                            <Editor Text="{Binding Complemento}"  Placeholder="Apartamento, bloco, referência..." AutoSize="Disabled" HeightRequest="64" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimaryColor}" PlaceholderColor="{StaticResource TextMutedColor}" FontFamily="InterRegular" FontSize="14"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <!-- Ações com larguras iguais em duas colunas ou empilhadas em janela estreita. -->
                <Grid x:Name="RodapeAcoes" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="12" Margin="0,12,0,0">
                    <Button x:Name="BotaoCancelar" Grid.Column="0" Text="Cancelar" Command="{Binding CancelarCommand}" IsEnabled="{Binding IsNotBusy}" HeightRequest="52" CornerRadius="26" BackgroundColor="White" BorderColor="#F6C9CE" BorderWidth="1.5" TextColor="#E11D48" FontFamily="InterBold" FontSize="15"/>
                    <Button x:Name="BotaoPublicar" Grid.Column="1" Text="{Binding BotaoPublicar}" Command="{Binding PublicarCommand}" IsEnabled="{Binding IsNotBusy}" HeightRequest="52" CornerRadius="26" BackgroundColor="{StaticResource AuthPrimaryColor}" TextColor="{StaticResource TextPrimaryColor}" FontFamily="InterBold" FontSize="15"/>
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AuthPrimaryColor}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
